# Zkopiruj jako ~/.config/vtt-cz/email.env a nastav prava chmod 600.
# Pouzij vyhrazenou schranku pro vtt-cz a aplikacni heslo, nikoli hlavni heslo.
VTT_CZ_EMAIL_SMTP_ADDR=smtp.example.com:465
VTT_CZ_EMAIL_SMTP_MODE=tls
VTT_CZ_EMAIL_IMAP_ADDR=imap.example.com:993
VTT_CZ_EMAIL_USERNAME=vtt-cz-bot@example.com
VTT_CZ_EMAIL_PASSWORD=NAHRAD_APLIKACNIM_HESLEM
VTT_CZ_EMAIL_FROM=vtt-cz-bot@example.com
VTT_CZ_EMAIL_TO=uzivatel@example.net
VTT_CZ_EMAIL_ALLOWED_FROM=uzivatel@example.net
VTT_CZ_EMAIL_MAILBOX=INBOX
VTT_CZ_WORK_ROOT=/home/UZIVATEL/Videos/vtt-cz
