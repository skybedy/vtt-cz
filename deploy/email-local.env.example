# Lokalni Postfix + Maildir na stejne VPS. Zkopiruj mimo repozitar a chmod 600.
VTT_CZ_EMAIL_TRANSPORT=local
VTT_CZ_EMAIL_FROM=vtt-cz@example.com
VTT_CZ_EMAIL_TO=uzivatel@example.net
VTT_CZ_EMAIL_ALLOWED_FROM=uzivatel@example.net
VTT_CZ_EMAIL_SENDMAIL=/usr/sbin/sendmail
VTT_CZ_EMAIL_MAILDIR=/home/UZIVATEL/Maildir
VTT_CZ_WORK_ROOT=/home/UZIVATEL/Videos/vtt-cz
