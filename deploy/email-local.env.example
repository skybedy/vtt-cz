# Lokalni Postfix + Maildir na stejne VPS. Zkopiruj mimo repozitar a chmod 600.
VTT_CZ_EMAIL_TRANSPORT=local
VTT_CZ_EMAIL_FROM=vtt-cz@example.com
VTT_CZ_EMAIL_TO=uzivatel@example.net
VTT_CZ_EMAIL_ALLOWED_FROM=uzivatel@example.net
VTT_CZ_EMAIL_SENDMAIL=/usr/sbin/sendmail
VTT_CZ_EMAIL_MAILDIR=/home/UZIVATEL/Maildir
VTT_CZ_WORK_ROOT=/home/UZIVATEL/Videos/vtt-cz
VTT_CZ_YTDLP_COOKIES_FROM_BROWSER=none
VTT_CZ_YTDLP_AUTO_UPDATE=false
VTT_CZ_YTDLP_JS_RUNTIMES=node:/usr/local/bin/node
# Cesty uprav podle skutecne instalace whisper.cpp na VPS.
VTT_CZ_WHISPER_BIN=/home/UZIVATEL/whisper.cpp/build/bin/whisper-cli
VTT_CZ_VAD_BIN=/home/UZIVATEL/whisper.cpp/build/bin/vad-speech-segments
VTT_CZ_WHISPER_MODEL=/home/UZIVATEL/whisper.cpp/models/ggml-large-v3.bin
VTT_CZ_VAD_MODEL=/home/UZIVATEL/whisper.cpp/models/for-tests-silero-v5.1.2-ggml.bin
